PORT=8080
CORS_ORIGIN=http://localhost:5173,https://handa-awareness.netlify.app

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=handa_db

# Choose ONE Firebase Admin credential method.
# Option A: keep the downloaded JSON at backend/serviceAccountKey.json (never commit it).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: put the complete service-account JSON on one line instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
